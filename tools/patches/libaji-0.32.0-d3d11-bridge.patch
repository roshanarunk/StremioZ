+// d3d11_bridge.h - D3D11 frames for the CUDA backends (aji_trt, aji_trtrtx).
+//
+// vf_animejanai hands D3D11 textures to whatever backend the conf names when
+// mpv decodes with d3d11va (the renderer is D3D11, for example so that the
+// output can feed mpv's d3d11vpp filter: NVIDIA RTX Video HDR / Super
+// Resolution). The CUDA backends work on CUdeviceptr planes, so this bridge
+// moves frames across:
+//
+//   D3D11 (caller's copy into its SHARED|NTHANDLE input texture)
+//     --fence--> D3D12 copy queue: texture planes -> linear shared buffers
+//     --fence--> CUDA: the unchanged backend code reads/writes those buffers
+//     --fence--> D3D12 copy queue: linear buffers -> output texture planes
+//     --fence--> D3D11 (the caller's next use waits on the GPU)
+//
+// One shared D3D12 fence carries the whole chain (opened in D3D11, imported in
+// CUDA as an external semaphore). D3D12 does the plane copies because CUDA's
+// external-memory arrays cannot map P010 textures (CUDA_ERROR_INVALID_VALUE)
+// and CUDA graphics interop rejects NTHANDLE-shared textures and only exposes
+// an NV12 texture's luma plane. Buffers -> CUDA is plain linear memory.
+//
+// All calls happen on the caller's thread (the filter's); everything is
+// enqueued, nothing waits on the CPU except ticket waits.
+#pragma once
+#ifdef _WIN32
+
+#include <cuda.h>
+#include <cstdint>
+#include <functional>
+#include <memory>
+#include <string>
+
+#include "aji.h"
+
+namespace ajid3d {
+
+class Bridge {
+public:
+    // fn gets CUDA views of the frames (same width/height/format/matrix/...,
+    // planes as CUdeviceptr with the staging pitch) and the stream to use.
+    using Fn = std::function<int(const aji_frame *const *ins,
+                                 const aji_frame *const *outs, CUstream)>;
+
+    virtual ~Bridge() = default;
+
+    // CUDA device on the same adapter as the D3D11 device.
+    virtual CUdevice cuda_device() const = 0;
+    // Second step of creation, with the backend's context current.
+    virtual bool attach(CUcontext ctx, std::string &err) = 0;
+
+    // Moves ins (read) and outs (written) across and runs fn in between.
+    // Returns fn's result, or an AJI_ERR* code with err set.
+    virtual int run(const aji_frame *const *ins, int n_in,
+                    const aji_frame *const *outs, int n_out,
+                    const Fn &fn, std::string &err) = 0;
+    // True while fn runs (the backend's own entry points then skip the bridge).
+    virtual bool busy() const = 0;
+    virtual CUstream stream() const = 0;
+
+    // Tickets: the fence value after everything enqueued so far.
+    virtual uint64_t flush() = 0;
+    virtual int done(uint64_t ticket) = 0;   // 1 done, 0 not yet, <0 error
+    virtual int wait(uint64_t ticket) = 0;   // AJI_OK or error
+};
+
+// d3d11_device: the caller's ID3D11Device*. Null with err on failure.
+std::unique_ptr<Bridge> create(void *d3d11_device, std::string &err);
+
+}  // namespace ajid3d
+
+#endif  // _WIN32
