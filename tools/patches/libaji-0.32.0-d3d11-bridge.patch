+std::unique_ptr<Bridge> create(void *d3d11_device, std::string &err)
+{
+    if (!d3d11_device) {
+        err = "no D3D11 device";
+        return nullptr;
+    }
+    auto b = std::make_unique<Impl>();
+    if (!b->init(d3d11_device, err))
+        return nullptr;
+    return b;
+}
